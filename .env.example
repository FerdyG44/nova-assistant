# 1) Bu dosyayı kopyala:  cp .env.example .env
# 2) Token üret ve aşağıya yaz:  openssl rand -hex 24
# Not: açıklamaları değerle aynı satıra yazma; her ayar kendi satırında, açıklaması üstünde.
NOVA_TOKEN=buraya-uzun-rastgele-bir-token
NOVA_HOST=127.0.0.1
NOVA_PORT=8800

# --- Sen
# Nova sana hangi adla hitap etsin
NOVA_OWNER=
# Hava durumu için varsayılan şehir
NOVA_HOME_CITY=İstanbul
# Sık kullandığın özel isimler (proje/uygulama adları), virgülle: ses tanımayı iyileştirir
#NOVA_STT_HINTS=

# --- Beyin: Claude API (önerilen) ya da lokal model (ücretsiz)
# Anahtar yazarsan Claude kullanılır; boş bırakırsan Ollama'daki lokal model.
ANTHROPIC_API_KEY=
#NOVA_CLAUDE_MODEL=claude-sonnet-5-5
# Lokal model. 16 GB RAM: qwen3:8b · 8 GB RAM: qwen3:4b
NOVA_MODEL=qwen3:8b

# --- Ses: edge (Microsoft sesleri, internet ister) | piper (lokal) | say (macOS)
#NOVA_TTS_ENGINE=edge
# Erkek ses için: tr-TR-AhmetNeural
#NOVA_EDGE_VOICE=tr-TR-EmelNeural

# --- "Nova" diye seslenince tam ekran yüz (0 yaparsan sadece telefon modu)
NOVA_WAKE=1
NOVA_BROWSER=Google Chrome
# Ortam gürültülüyse yükselt (0.02-0.03), seni duymuyorsa düşür (0.008)
NOVA_MIC_THRESHOLD=0.015
# Cevaptan sonra ismini söylemeden devam edebileceğin süre (saniye)
NOVA_FOLLOWUP_SECONDS=8
# Nova konuşurken "dur" / "Nova" diyerek sözünü kesebilirsin. Kendi kendine duruyorsa 0 yap.
#NOVA_BARGE_IN=1

# --- Ev: Apple TV (isteğe bağlı). Önce bir kez eşleştir:  server/.venv/bin/atvremote wizard
# Birden fazla Apple TV varsa adı (örn. Salon)
#NOVA_APPLETV_NAME=
# Boşsa Spotify, yoksa Apple Music
#NOVA_TV_MUSIC_APP=
